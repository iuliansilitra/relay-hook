<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>RelayHook.SqlServer</PackageId>
    <Title>RelayHook SQL Server</Title>
    <Description>Durable SQL Server storage, automatic schema migrations, leases, and atomic callback claiming for RelayHook.</Description>
    <PackageTags>$(PackageTags);sqlserver;storage;database</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <ProjectReference Include="../RelayHook.Core/RelayHook.Core.csproj" />
    <EmbeddedResource Include="Migrations/*.sql" />
    <InternalsVisibleTo Include="RelayHook.AspNetCore" />
    <InternalsVisibleTo Include="RelayHook.SqlServer.Tests" />
    <InternalsVisibleTo Include="RelayHook.IntegrationTests" />
  </ItemGroup>
</Project>
